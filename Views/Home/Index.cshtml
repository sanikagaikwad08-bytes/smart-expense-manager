
@{
    ViewData["Title"] = "Smart Expense Manager";
}

<div class="container py-5">
    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold">Smart Expense Manager</h1>
        <p class="lead text-muted">
            Track your expenses and understand where your money goes.
        </p>
        <a asp-controller="Profile"
           asp-action="Index"
           class="btn btn-primary mt-3">
            Continue with Google to access your profile
        </a>
    </div>

    <div class="row g-4">
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h4>Track Expenses</h4>
                    <p>Add and manage your daily expenses in one place.</p>
                    <a asp-controller="Expenses"
                       asp-action="Index"
                       class="btn btn-outline-primary">
                        Track Expenses
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h4>View Dashboard</h4>
                    <p>See your spending totals and recent transactions.</p>
                    <a asp-controller="Dashboard"
                       asp-action="Index"
                       class="btn btn-outline-primary">
                        View Dashboard
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h4>Manage Profile</h4>
                    <p>Update your personal account information.</p>
                    <a asp-controller="Profile"
                       asp-action="Index"
                       class="btn btn-outline-primary">
                        Manage Profile
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
