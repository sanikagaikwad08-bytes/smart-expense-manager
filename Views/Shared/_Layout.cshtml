<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - SmartExpenseManager</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/SmartExpenseManager.styles.css"
          asp-append-version="true" />

</head>


<body>

    <header>

        <nav class="navbar navbar-light bg-white border-bottom box-shadow mb-3">

            <div class="container-fluid navbar-main">


                <!-- Logo + Website Name -->

                <a class="navbar-brand d-flex align-items-center"
                   asp-controller="Home"
                   asp-action="Index">

                    <span class="expense-logo">
                        ₹
                    </span>

                    <span class="website-name">
                        SmartExpenseManager
                    </span>

                </a>


                <!-- Right Side -->

                <div class="navbar-right">


                    <!-- Login -->

                    <a asp-controller="Account"
                       asp-action="Login"
                       class="btn btn-outline-primary login-btn">

                        Login

                    </a>


                    <!-- Sign Up -->

                    <a asp-controller="Account"
                       asp-action="Register"
                       class="btn btn-primary signup-btn">

                        Sign Up

                    </a>


                    <!-- Hamburger -->

                    <button class="navbar-toggler"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#mainMenu"
                            aria-controls="mainMenu"
                            aria-expanded="false"
                            aria-label="Toggle navigation">

                        <span class="navbar-toggler-icon"></span>

                    </button>

                </div>


                <!-- Menu -->

                <div class="navbar-collapse collapse"
                     id="mainMenu">

                    <ul class="navbar-nav">


                        <li class="nav-item">

                            <a class="nav-link text-dark"
                               asp-controller="Home"
                               asp-action="Index">

                                Home

                            </a>

                        </li>


                        <li class="nav-item">

                            <a class="nav-link text-dark"
                               asp-controller="Dashboard"
                               asp-action="Index">

                                Dashboard

                            </a>

                        </li>


                        <li class="nav-item">

                            <a class="nav-link text-dark"
                               asp-controller="Expenses"
                               asp-action="Index">

                                Expenses

                            </a>

                        </li>


                        <li class="nav-item">

                            <a class="nav-link text-dark"
                               asp-controller="Profile"
                               asp-action="Index">

                                Profile

                            </a>

                        </li>


                    </ul>

                </div>

            </div>

        </nav>

    </header>


    <div class="container">

        <main role="main" class="pb-3">

            @RenderBody()

        </main>

    </div>


    <footer class="border-top footer text-muted">

        <div class="container">

            &copy; 2026 - SmartExpenseManager

        </div>

    </footer>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true">
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>