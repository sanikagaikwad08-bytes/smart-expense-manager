@model SmartExpenseManager.Models.Expense

@{
    ViewData["Title"] = "Delete Expense";
}

<style>
    .delete-page {
        max-width: 1100px;
        margin: 0 auto;
        color: #29283d;
    }

    .delete-page-header {
        margin-bottom: 25px;
    }

    .delete-page-header h1 {
        margin: 0 0 7px;
        font-size: clamp(1.55rem, 3vw, 2rem);
        font-weight: 800;
        letter-spacing: -.8px;
    }

    .delete-page-header p {
        margin: 0;
        color: #9290a5;
        font-size: .9rem;
    }

    .delete-card {
        max-width: 620px;
        margin: 0 auto;
        padding: clamp(22px, 4vw, 34px);
        border: 1px solid #eeedf5;
        border-radius: 20px;
        background: #fff;
        box-shadow: 0 10px 35px rgba(46, 38, 91, .06);
    }

    .delete-warning {
        display: flex;
        align-items: flex-start;
        gap: 14px;
        padding: 17px;
        margin-bottom: 26px;
        border: 1px solid #f2dce3;
        border-radius: 13px;
        background: #fff5f7;
    }

    .delete-warning-icon {
        width: 42px;
        height: 42px;
        flex-shrink: 0;
        display: grid;
        place-items: center;
        border-radius: 12px;
        background: #ffe5ec;
        color: #c84e70;
        font-size: 1.2rem;
        font-weight: 800;
    }

    .delete-warning h2 {
        margin: 1px 0 6px;
        color: #9f3655;
        font-size: 1rem;
        font-weight: 800;
    }

    .delete-warning p {
        margin: 0;
        color: #986a79;
        font-size: .85rem;
        line-height: 1.65;
    }

    .delete-details-heading {
        margin-bottom: 15px;
        color: #39364f;
        font-size: 1rem;
        font-weight: 800;
    }

    .delete-details {
        overflow: hidden;
        margin-bottom: 25px;
        border: 1px solid #eeedf5;
        border-radius: 13px;
    }

    .delete-detail-row {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 16px;
        padding: 15px 17px;
        border-bottom: 1px solid #f0eef6;
        font-size: .87rem;
    }

    .delete-detail-row:last-child {
        border-bottom: 0;
    }

    .delete-detail-label {
        color: #89859d;
    }

    .delete-detail-value {
        color: #37344f;
        font-weight: 700;
        text-align: right;
        overflow-wrap: anywhere;
    }

    .delete-amount {
        color: #b63f60;
        font-size: 1rem;
    }

    .delete-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        padding-top: 21px;
        border-top: 1px solid #f0eef6;
    }

    .delete-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 45px;
        padding: 11px 20px;
        border: 1px solid #e5e2f2;
        border-radius: 10px;
        background: white;
        color: #5e55b8;
        text-decoration: none;
        font-size: .87rem;
        font-weight: 700;
        cursor: pointer;
    }

    .delete-btn:hover {
        background: #f1efff;
        color: #5143c0;
    }

    .delete-btn-danger {
        border-color: #d95370;
        background: #d95370;
        color: white;
    }

    .delete-btn-danger:hover {
        border-color: #bd3f5d;
        background: #bd3f5d;
        color: white;
    }

    @@media (max-width: 480px) {
        .delete-actions {
            flex-direction: column;
        }

        .delete-btn {
            width: 100%;
        }

        .delete-detail-row {
            padding: 13px;
        }
    }
</style>

<div class="container py-4 py-md-5">
    <main class="delete-page">

        <header class="delete-page-header">
            <h1>Delete Expense</h1>
            <p>Review the details before confirming deletion.</p>
        </header>

        <section class="delete-card">

            <div class="delete-warning">
                <div class="delete-warning-icon" aria-hidden="true">!</div>
                <div>
                    <h2>Are you sure?</h2>
                    <p>
                        This will permanently delete this expense.
                        You cannot undo this action.
                    </p>
                </div>
            </div>

            <h3 class="delete-details-heading">Expense details</h3>

            <div class="delete-details">
                <div class="delete-detail-row">
                    <span class="delete-detail-label">Category</span>
                    <span class="delete-detail-value">@Model.Category</span>
                </div>

                <div class="delete-detail-row">
                    <span class="delete-detail-label">Amount</span>
                    <span class="delete-detail-value delete-amount">
                        ₹@Model.Amount.ToString("N2")
                    </span>
                </div>

                <div class="delete-detail-row">
                    <span class="delete-detail-label">Date</span>
                    <span class="delete-detail-value">
                        @Model.ExpenseDate.ToString("dd MMM yyyy")
                    </span>
                </div>

                <div class="delete-detail-row">
                    <span class="delete-detail-label">Payment method</span>
                    <span class="delete-detail-value">@Model.PaymentMethod</span>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.Description))
                {
                    <div class="delete-detail-row">
                        <span class="delete-detail-label">Description</span>
                        <span class="delete-detail-value">@Model.Description</span>
                    </div>
                }
            </div>

            <form asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />

                <div class="delete-actions">
                    <button type="submit" class="delete-btn delete-btn-danger">
                        Delete Expense
                    </button>

                    <a asp-action="Index" class="delete-btn">
                        Cancel
                    </a>
                </div>
            </form>

        </section>
    </main>
</div>
