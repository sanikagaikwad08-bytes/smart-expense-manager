@model IEnumerable<SmartExpenseManager.Models.Expense>

@{
    ViewData["Title"] = "Expenses";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1>Expenses</h1>

            <p class="text-muted">
                Manage your daily expenses.
            </p>
        </div>

        <a asp-action="Create"
           class="btn btn-primary">
            Add Expense
        </a>

    </div>


    <div class="card shadow-sm">

        <div class="card-body">

            @if (!Model.Any())
            {
                <div class="text-center py-5">

                    <h5>No expenses yet</h5>

                    <p class="text-muted">
                        Add your first expense to get started.
                    </p>

                    <a asp-action="Create"
                       class="btn btn-primary">
                        Add Expense
                    </a>

                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table align-middle">

                        <thead>

                            <tr>
                                <th>Category</th>
                                <th>Description</th>
                                <th>Amount</th>
                                <th>Date</th>
                                <th>Payment</th>
                                <th>Actions</th>
                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var expense in Model)
                            {
                                <tr>

                                    <td>
                                        @expense.Category
                                    </td>

                                    <td>
                                        @(string.IsNullOrEmpty(expense.Description)
                                            ? "-"
                                            : expense.Description)
                                    </td>

                                    <td>
                                        ₹@expense.Amount
                                    </td>

                                    <td>
                                        @expense.ExpenseDate.ToString("dd MMM yyyy")
                                    </td>

                                    <td>
                                        @expense.PaymentMethod
                                    </td>

                                    <td>

                                        <a asp-action="Edit"
                                           asp-route-id="@expense.Id"
                                           class="btn btn-sm btn-outline-primary me-2">
                                            Edit
                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@expense.Id"
                                           class="btn btn-sm btn-outline-danger">
                                            Delete
                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>