@model SmartExpenseManager.Models.ApplicationUser

@{
    ViewData["Title"] = "Profile";

    var hasSavedPhoto = Model.ProfileImage is { Length: > 0 };
    var hasExternalPhoto = !string.IsNullOrWhiteSpace(Model.ProfilePictureUrl);

    var avatarUrl = hasSavedPhoto
        ? Url.Action("Photo", "Profile")
        : hasExternalPhoto ? Model.ProfilePictureUrl : null;

    var displayName = !string.IsNullOrWhiteSpace(Model.FullName)
        ? Model.FullName
        : Model.UserName ?? "User";

    var initial = displayName.Length > 0
        ? char.ToUpperInvariant(displayName[0]).ToString()
        : "?";
}

<style>
    .profile-page {
        max-width: 900px;
        margin: 0 auto;
        padding: 20px 0 40px;
        color: #172b4d;
        --accent: #2878e8;
        --muted: #65748b;
        --border: #e2eaf4;
    }

    .profile-heading {
        margin-bottom: 22px;
    }

    .profile-heading h1 {
        font-size: 1.65rem;
        font-weight: 700;
        margin-bottom: 6px;
    }

    .profile-heading p {
        color: var(--muted);
        margin: 0;
    }

    .profile-card {
        background: #fff;
        border: 1px solid var(--border);
        border-radius: 16px;
        padding: 26px;
        margin-bottom: 18px;
        box-shadow: 0 3px 12px rgba(29, 58, 100, .035);
    }

    .profile-hero {
        text-align: center;
        padding: 36px 24px 28px;
        background: linear-gradient(180deg, #f2f7ff 0%, #fff 75%);
    }

    .avatar-wrap {
        width: 124px;
        height: 124px;
        position: relative;
        margin: 0 auto 18px;
    }

    .profile-avatar {
        width: 100%;
        height: 100%;
        border-radius: 50%;
        overflow: hidden;
        background: #e6efff;
        border: 4px solid #fff;
        box-shadow: 0 0 0 1px var(--border),
                    0 5px 16px rgba(30, 65, 110, .12);
        display: flex;
        justify-content: center;
        align-items: center;
        color: var(--accent);
        font-size: 2.5rem;
        font-weight: 700;
    }

    .profile-avatar img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .avatar-camera {
        position: absolute;
        right: 0;
        bottom: 2px;
        width: 40px;
        height: 40px;
        border: 3px solid #fff;
        border-radius: 50%;
        background: var(--accent);
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        box-shadow: 0 2px 6px rgba(40, 120, 232, .2);
    }

    .avatar-camera:hover {
        background: #1764cb;
    }

    .profile-name {
        font-size: 1.6rem;
        font-weight: 700;
        margin: 0 0 8px;
        overflow-wrap: anywhere;
    }

    .profile-detail {
        color: var(--muted);
        font-size: .96rem;
        margin: 6px 0;
        overflow-wrap: anywhere;
    }

    .profile-actions {
        display: flex;
        justify-content: center;
        gap: 10px;
        flex-wrap: wrap;
        margin-top: 20px;
    }

    .profile-divider {
        border: 0;
        border-top: 1px solid var(--border);
        margin: 28px 0 0;
    }

    .section-heading {
        display: flex;
        align-items: center;
        gap: 14px;
        margin-bottom: 22px;
    }

    .section-icon {
        width: 44px;
        height: 44px;
        flex-shrink: 0;
        border-radius: 50%;
        background: #eaf2ff;
        color: var(--accent);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
    }

    .section-heading h2 {
        font-size: 1.08rem;
        font-weight: 700;
        margin: 0 0 4px;
    }

    .section-heading p {
        color: var(--muted);
        font-size: .88rem;
        margin: 0;
    }

    .info-row {
        display: flex;
        justify-content: space-between;
        gap: 16px;
        padding: 14px 0;
        border-bottom: 1px solid var(--border);
    }

    .info-row:last-child {
        border-bottom: 0;
    }

    .info-label {
        color: var(--muted);
        font-size: .9rem;
    }

    .info-value {
        font-weight: 600;
        text-align: right;
        overflow-wrap: anywhere;
    }

    .profile-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        border: 1px solid var(--accent);
        border-radius: 9px;
        background: var(--accent);
        color: #fff;
        padding: 10px 18px;
        font-size: .9rem;
        font-weight: 600;
        text-decoration: none;
        cursor: pointer;
        transition: background .15s;
    }

    .profile-btn:hover {
        background: #1764cb;
        color: #fff;
    }

    .profile-btn-outline {
        background: #fff;
        color: var(--accent);
    }

    .profile-btn-outline:hover {
        background: #f0f6ff;
        color: #1764cb;
    }

    .security-row {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .security-copy {
        flex: 1;
        min-width: 0;
    }

    .security-copy h2 {
        font-size: 1rem;
        font-weight: 700;
        margin: 0 0 5px;
    }

    .security-copy p {
        color: var(--muted);
        font-size: .87rem;
        margin: 0;
    }

    @@media (max-width: 576px) {
        .profile-page {
            padding-top: 8px;
        }

        .profile-card {
            padding: 18px;
            border-radius: 12px;
        }

        .profile-hero {
            padding: 28px 16px 22px;
        }

        .profile-name {
            font-size: 1.35rem;
        }

        .profile-btn {
            max-width: 100%;
        }

        .security-row {
            align-items: flex-start;
        }
    }
</style>

<div class="profile-page">

    <div class="profile-heading">
        <h1>My Profile</h1>
        <p>View and manage your account information.</p>
    </div>

    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success" role="alert">@success</div>
    }

    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-danger" role="alert">@error</div>
    }

    <section class="profile-card profile-hero">

        <div class="avatar-wrap">
            <div class="profile-avatar">
                @if (!string.IsNullOrWhiteSpace(avatarUrl))
                {
                    <img src="@avatarUrl" alt="Profile photo" />
                }
                else
                {
                    <span>@initial</span>
                }
            </div>

            <button type="button"
                    class="avatar-camera"
                    id="cameraButton"
                    aria-label="Change profile photo"
                    title="Change profile photo">
                <svg width="20" height="20" viewBox="0 0 24 24"
                     fill="none" stroke="currentColor"
                     stroke-width="2" aria-hidden="true">
                    <path d="M14 4h-4L8 7H4a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-4z" />
                    <circle cx="12" cy="13" r="3" />
                </svg>
            </button>
        </div>

        <h2 class="profile-name">@displayName</h2>

        <p class="profile-detail">
            <strong>Username:</strong> @(Model.UserName ?? "Not set")
        </p>

        <p class="profile-detail">
            <strong>Gmail:</strong> @(Model.Email ?? "Not set")
        </p>

        <p class="profile-detail">
            <strong>Age:</strong> @(Model.Age?.ToString() ?? "Not added")
        </p>

        <form asp-action="UploadPhoto"
              method="post"
              enctype="multipart/form-data"
              id="photoForm">

            @Html.AntiForgeryToken()

            <input type="file"
                   id="photoInput"
                   name="photo"
                   accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
                   hidden />

            <div class="profile-actions">
                <a asp-controller="Profile"
                   asp-action="Edit"
                   class="profile-btn profile-btn-outline">
                    Edit Profile
                </a>

                <button type="submit"
                        class="profile-btn"
                        id="photoSaveButton"
                        hidden>
                    Save Photo
                </button>
            </div>

            <p id="photoMessage"
               class="small mt-3 mb-0"
               role="status"
               aria-live="polite"></p>
        </form>

        <hr class="profile-divider" />
    </section>

    <section class="profile-card">
        <div class="section-heading">
            <div class="section-icon" aria-hidden="true">
                <svg width="23" height="23" viewBox="0 0 24 24"
                     fill="none" stroke="currentColor"
                     stroke-width="1.8">
                    <circle cx="12" cy="8" r="4" />
                    <path d="M4 21a8 8 0 0 1 16 0" />
                </svg>
            </div>

            <div>
                <h2>Personal Information</h2>
                <p>Your current account information.</p>
            </div>
        </div>

        <div class="info-row">
            <span class="info-label">Full name</span>
            <span class="info-value">
                @(string.IsNullOrWhiteSpace(Model.FullName)
                    ? "Not added"
                    : Model.FullName)
            </span>
        </div>

        <div class="info-row">
            <span class="info-label">Username</span>
            <span class="info-value">@(Model.UserName ?? "Not set")</span>
        </div>

        <div class="info-row">
            <span class="info-label">Email address</span>
            <span class="info-value">@(Model.Email ?? "Not set")</span>
        </div>

        <div class="info-row">
            <span class="info-label">Age</span>
            <span class="info-value">
                @(Model.Age?.ToString() ?? "Not added")
            </span>
        </div>

        <div class="profile-actions">
            <a asp-controller="Profile"
               asp-action="Edit"
               class="profile-btn">
                Edit Information
            </a>
        </div>
    </section>

    <section class="profile-card">
        <div class="security-row">
            <div class="section-icon" aria-hidden="true">
                <svg width="23" height="23" viewBox="0 0 24 24"
                     fill="none" stroke="currentColor"
                     stroke-width="1.8">
                    <path d="M12 22s8-4 8-11V5l-8-3-8 3v6c0 7 8 11 8 11z" />
                    <path d="m9 12 2 2 4-4" />
                </svg>
            </div>

            <div class="security-copy">
                <h2>Account Security</h2>
                <p>Your account is protected by your sign-in system.</p>
            </div>
        </div>
    </section>

</div>

@section Scripts {
    <script>
        (function () {
            const input = document.getElementById('photoInput');
            const cameraButton = document.getElementById('cameraButton');
            const photoSaveButton = document.getElementById('photoSaveButton');
            const message = document.getElementById('photoMessage');
            const photoForm = document.getElementById('photoForm');

            cameraButton.addEventListener('click', function () {
                input.click();
            });

            input.addEventListener('change', function () {
                const file = input.files && input.files[0];

                if (!file) {
                    photoSaveButton.hidden = true;
                    return;
                }

                const allowedTypes = [
                    'image/jpeg',
                    'image/png',
                    'image/webp'
                ];

                if (!allowedTypes.includes(file.type)) {
                    message.textContent =
                        'Choose a valid JPG, PNG, or WebP image.';
                    input.value = '';
                    photoSaveButton.hidden = true;
                    return;
                }

                if (file.size > 2 * 1024 * 1024) {
                    message.textContent =
                        'Choose an image smaller than 2 MB.';
                    input.value = '';
                    photoSaveButton.hidden = true;
                    return;
                }

                message.textContent =
                    'Photo selected. Select Save Photo to upload it.';
                photoSaveButton.hidden = false;
            });

            photoForm.addEventListener('submit', function (event) {
                if (!input.files || input.files.length === 0) {
                    event.preventDefault();
                    message.textContent = 'Please choose a photo first.';
                }
            });
        })();
    </script>
}
