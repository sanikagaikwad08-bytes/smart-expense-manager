@{
    ViewData["Title"] = "Profile";
}

<div class="container mt-4">

    <div class="mb-4">
        <h1>My Profile</h1>
        <p class="text-muted">Manage your account information.</p>
    </div>

    <div class="card p-4 shadow-sm mb-4">

        <h4>@ViewBag.FullName</h4>

        <p class="text-muted mb-1">
            @ViewBag.Email
        </p>

        <p class="text-muted">
            Login method: @ViewBag.Provider
        </p>

        <hr />

        <form asp-action="UpdateName" method="post">

            <div class="mb-3">
                <label class="form-label">Name</label>

                <input type="text"
                       name="fullName"
                       value="@ViewBag.FullName"
                       class="form-control" />
            </div>

            <button type="submit" class="btn btn-primary">
                Update Name
            </button>

        </form>

    </div>

    <div class="row g-3">

        <div class="col-md-6">
            <div class="card p-4 shadow-sm">
                <h6>Total Spent</h6>
                <h3>₹@ViewBag.TotalExpenses</h3>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card p-4 shadow-sm">
                <h6>Total Transactions</h6>
                <h3>@ViewBag.TransactionCount</h3>
            </div>
        </div>

    </div>

</div>