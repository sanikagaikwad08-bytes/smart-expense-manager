@{
    ViewData["Title"] = "Dashboard";
}

<div class="container mt-4">

    <div class="mb-4">
        <h1>Dashboard</h1>
        <p class="text-muted">
            Here's an overview of your expenses.
        </p>
    </div>

    <div class="row g-3 mb-4">

        <div class="col-md-4">
            <div class="card p-3 shadow-sm">
                <h6>Total Spent</h6>
                <h2>₹@ViewBag.TotalSpent</h2>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card p-3 shadow-sm">
                <h6>This Month</h6>
                <h2>₹@ViewBag.ThisMonthSpent</h2>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card p-3 shadow-sm">
                <h6>Transactions</h6>
                <h2>@ViewBag.TransactionCount</h2>
            </div>
        </div>

    </div>

    <div class="card p-4 shadow-sm mb-4">
        <h5>Top Spending Category</h5>
        <h3>@ViewBag.TopCategory</h3>
    </div>

    <div class="card p-4 shadow-sm">

        <div class="d-flex justify-content-between align-items-center mb-3">

            <h5>Recent Expenses</h5>

            <a asp-controller="Expenses"
               asp-action="Create"
               class="btn btn-primary">
                Add Expense
            </a>

        </div>

        @if (ViewBag.RecentExpenses.Count == 0)
        {
            <p class="text-muted">
                No expenses yet. Add your first expense.
            </p>
        }
        else
        {
            <div class="table-responsive">

                <table class="table">

                    <thead>
                        <tr>
                            <th>Category</th>
                            <th>Amount</th>
                            <th>Date</th>
                            <th>Payment</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var expense in ViewBag.RecentExpenses)
                        {
                            <tr>
                                <td>@expense.Category</td>
                                <td>₹@expense.Amount</td>
                                <td>@expense.ExpenseDate.ToString("dd MMM yyyy")</td>
                                <td>@expense.PaymentMethod</td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>

</div>