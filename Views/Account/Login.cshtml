
@{
    ViewData["Title"] = "Continue with Google";
}

<div class="container mt-5" style="max-width: 420px;">
    <div class="card shadow-sm p-4">
        <h2 class="text-center mb-2">Welcome</h2>

        <p class="text-center text-muted mb-4">
            Sign in or create your account to access your profile.
        </p>

        @if (TempData["Error"] is string error)
        {
            <div class="alert alert-danger">@error</div>
        }

        <a asp-controller="Account"
           asp-action="GoogleLogin"
           class="btn btn-outline-dark w-100 py-2">
            Continue with Google
        </a>

        <p class="text-center text-muted mt-3 mb-0">
            New here? Your account will be created automatically.
        </p>

        <div class="text-center mt-3">
            <a asp-controller="Home"
               asp-action="Index">
                Back to home
            </a>
        </div>
    </div>
</div>
